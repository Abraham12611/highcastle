{
  "name": "@highcastle/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @highcastle/contracts --filter @highcastle/ui build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @highcastle/contracts --filter @highcastle/ui build && next typegen && tsc --noEmit",
    "test": "pnpm --filter @highcastle/contracts --filter @highcastle/ui build && vitest run"
  },
  "dependencies": {
    "@highcastle/contracts": "workspace:*",
    "@highcastle/ui": "workspace:*",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "catalog:",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
