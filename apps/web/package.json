{
  "name": "@highcastle/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @highcastle/contracts --filter @highcastle/ui --filter @highcastle/db --filter @highcastle/security --filter @highcastle/test-packs build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @highcastle/contracts --filter @highcastle/ui --filter @highcastle/db --filter @highcastle/security --filter @highcastle/test-packs build && next typegen && tsc --noEmit",
    "test": "pnpm --filter @highcastle/contracts --filter @highcastle/ui --filter @highcastle/db --filter @highcastle/security --filter @highcastle/test-packs build && vitest run"
  },
  "dependencies": {
    "@highcastle/contracts": "workspace:*",
    "@highcastle/db": "workspace:*",
    "@highcastle/security": "workspace:*",
    "@highcastle/test-packs": "workspace:*",
    "@highcastle/ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "catalog:",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
