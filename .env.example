# HighCastle environment template — variable names only, no real values.
# Copy to .env.local (apps/web) or .env (apps/worker) and fill in locally.
# Never commit real secrets. Anything not prefixed NEXT_PUBLIC_ is server-only.

# --- Database (L02 · packages/db) ---
DATABASE_URL=

# --- Auth (L05 · Better Auth + GitHub OAuth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Vultr Serverless Inference (L12 · server-side only) ---
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

# --- Application ---
HIGHCASTLE_APP_URL=

# --- Evidence storage (Vultr Object Storage; optional for hackathon) ---
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_KEY=
EVIDENCE_STORAGE_SECRET=

# --- Worker ---
WORKER_INTERNAL_TOKEN=
# Port for the worker /healthz endpoint (apps/worker).
WORKER_PORT=

# --- Demo target lab (L11 · owned synthetic lab only, never third-party hosts) ---
DEMO_TARGET_BASE_URL=
