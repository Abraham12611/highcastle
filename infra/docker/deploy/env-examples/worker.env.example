# /etc/highcastle/worker.env — consumed ONLY by the `worker` service
# (orchestrator + trusted sandbox controller). Never reaches lab or runners.
# Template: copy to the secrets dir, fill in, chmod 0600. Never commit values.

DATABASE_URL=

# Shared secret the web/API uses to authenticate internal worker callbacks:
WORKER_INTERNAL_TOKEN=

# Vultr Serverless Inference — server-side only (Challenge 1 requirement).
# https://api.vultrinference.com/v1 is the OpenAI-compatible base URL.
VULTR_INFERENCE_API_KEY=
# Model ID from the live Vultr model list (verify before demo):
VULTR_INFERENCE_MODEL=

# Digest of the lab image currently served as `target-lab`; recorded into each
# scan snapshot by the orchestrator. Refresh after every lab image swap:
#   docker image inspect highcastle/target-lab:<rev> --format '{{.Id}}'
HIGHCASTLE_TARGET_IMAGE_DIGEST=
