# deploy.env — compose-level (non-secret) deployment settings for compose.yaml.
# Source it before `docker compose`, or place a copy next to compose.yaml as
# `.env` on the VM (compose auto-reads ./.env — keep it OUT of git either way).

# Public hostname the Caddyfile serves — an A/AAAA record must point at the VM.
# For local bring-up: `localhost`.
HIGHCASTLE_DOMAIN=

# Release tag for locally built images (build-images.sh defaults to `dev`):
HIGHCASTLE_RELEASE=

# Which lab image serves the contract-fixed `target-lab` alias.
# Initial scan:  highcastle/target-lab:lab-v1-vulnerable
# Replay:        highcastle/target-lab:lab-v2-patched   (or a pinned digest)
TARGET_LAB_IMAGE=

# Runner image the trusted controller launches (built by build-images.sh):
HIGHCASTLE_RUNNER_IMAGE=highcastle/runner:0.1.0

# Lab image digest recorded into scan snapshots (worker.env mirrors this):
HIGHCASTLE_TARGET_IMAGE_DIGEST=

# Where the four secret env files live on the VM (NOT inside the repo):
HIGHCASTLE_SECRETS_DIR=/etc/highcastle
