# /etc/highcastle/web.env — consumed ONLY by the `web` service.
# Server-side secrets for the control plane. Never reaches lab or runners.
# Template: copy to the secrets dir, fill in, chmod 0600. Never commit values.

# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# — host is the compose service name on the internal `highcastle-data` net.
DATABASE_URL=

# Better Auth session signing secret (e.g. `openssl rand -base64 32`):
BETTER_AUTH_SECRET=
# Public base URL of the app, e.g. https://app.example.com
BETTER_AUTH_URL=

# GitHub OAuth app credentials (L05 auth flow):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

HIGHCASTLE_APP_URL=

# Vultr Object Storage evidence bucket — OPTIONAL for hackathon; if unset the
# app uses the documented local private-volume fallback.
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_KEY=
EVIDENCE_STORAGE_SECRET=

# Display/deep-link only. The lab is NOT reachable from `web` — it lives on
# the internal runner network with no route out. If a live lab-browse view is
# needed for the demo, use the SSH-tunnel procedure in infra/vultr/README.md.
DEMO_TARGET_BASE_URL=

# Trusted proxy (issue #83). Set to 1 ONLY because the managed Caddy edge is
# the sole proxy in front of web — it appends the true remote address as the
# last X-Forwarded-For hop. When unset/0, all forwarded headers are ignored
# and client identity resolves to "unknown" (fail closed). Never set this on
# a directly exposed web process.
TRUST_PROXY=1

# Scan admission ceilings (issue #83). Enforced atomically inside the
# scan-creation transaction; sized for the 2 GB VM so sandbox runners cannot
# overcommit memory. Omit to keep these safe defaults.
SCAN_MAX_ACTIVE_PER_PROJECT=5
SCAN_MAX_ACTIVE_PER_WORKSPACE=8
SCAN_MAX_ACTIVE_PER_TARGET=5
SCAN_GUEST_MAX_PER_HOUR=6
SCAN_GUEST_MAX_PER_DAY=10
SCAN_USER_MAX_PER_HOUR=60
