# lab-revisions.env — canonical vulnerable/patched revision -> image mapping
# for the contract-fixed `target-lab` alias (L19). Non-secret; committed.
#
# The alias never changes across a replay: only which image serves it, and
# the digest recorded into the scan snapshot (HIGHCASTLE_TARGET_IMAGE_DIGEST).
# Fixture set: alice-bob-invoices, FIXTURE_VERSION 1.0.0 (apps/target-lab).
#
# Build arg / app revision id   ->  image tag
lab-v1-vulnerable=highcastle/target-lab:lab-v1-vulnerable
lab-v2-patched=highcastle/target-lab:lab-v2-patched
