{
  "name": "@highcastle/sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "HighCastle sandbox execution controller (lane L14): bounded ephemeral runner lifecycle, Docker containment profile, containment evidence. Trusted controller; untrusted runner.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@highcastle/contracts": "workspace:*",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
