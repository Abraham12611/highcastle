{
  "name": "@highcastle/security",
  "version": "0.1.0",
  "description": "HighCastle deterministic authorization and policy engine — immutable scope hashing, policy decisions, scope intersection, target/URL safety, secret redaction. Lane L04.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @highcastle/contracts build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @highcastle/contracts build && tsc --noEmit",
    "test": "pnpm --filter @highcastle/contracts build && vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@highcastle/contracts": "workspace:*",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
